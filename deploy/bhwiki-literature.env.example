# Copy to `/etc/bhwiki/literature.env` with mode 0600 and fill values.
# The worker must have a writer/admin database URL; the public web process must not.
BHWIKI_ADMIN_DATABASE_URL=postgresql://<admin-or-owner>:<password>@127.0.0.1:54322/postgres
BHWIKI_LLM_BASE_URL=https://<provider>/v1
BHWIKI_LLM_API_KEY=<provider-key>
BHWIKI_LLM_MODEL=<structured-output-model>
BHWIKI_LITERATURE_SPOOL=/var/lib/bhwiki/literature
