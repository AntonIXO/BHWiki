{
  "name": "bhwiki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3086",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "test:e2e": "playwright test",
    "content:hashes": "tsx scripts/content-hashes.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:benchmark": "tsx scripts/db-benchmark.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "cytoscape": "3.34.3",
    "lucide-react": "1.48.0",
    "next": "16.3.7",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
