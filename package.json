{
  "name": "bhwiki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3086",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:portal": "tsx scripts/generate-portal.ts",
    "content:molekul": "tsx scripts/import-molekul.ts",
    "test:e2e": "playwright test",
    "content:hashes": "tsx scripts/content-hashes.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:benchmark": "tsx scripts/db-benchmark.ts",
    "db:verify:research": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/research-db-verify.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "cytoscape": "3.34.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "1.48.0",
    "next": "16.3.7",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
