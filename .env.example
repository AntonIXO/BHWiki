# Select a data source explicitly. Local development needs no database account.
BHWIKI_DATA_MODE=bundled

# For database mode, use ONLY the dedicated read-only bhwiki_reader credential.
# Supply secrets in an ignored local file or host secret storage; never in NEXT_PUBLIC_*.
# DATABASE_URL=postgresql://bhwiki_reader:REPLACE_IN_PRIVATE_SECRET_FILE@127.0.0.1:54322/postgres

# Optional actual source repository URL for public contribution links.
# Leave empty until a repository exists. No GitHub URL is assumed.
BHWIKI_REPOSITORY_URL=

# Migration/publishing administrator credentials are NOT runtime settings.
# Supply BHWIKI_ADMIN_DATABASE_URL only to the relevant one-off command.
